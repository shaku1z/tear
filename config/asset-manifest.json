{
  "schema": "tear-asset-manifest.v1",
  "about": "Every asset the game draws, one row each. The asset id is the contract: pnpm assets:sheets writes <category>/<id>/ and Shards items name art by the same id. scripts/asset-sheets/manifest.ts validates this file against the game's registries; docs/ASSET_SHEETS.md says how to add a row.",
  "idPattern": "^[a-z0-9_]{1,64}$",
  "budget": {
    "svgBytes": 100000,
    "pngBytes": 1500000,
    "png3xBytes": 8000000,
    "totalBytes": 200000000
  },
  "categories": [
    {
      "id": "player",
      "about": "The player with each weapon: idle, run, jump, dash, hit, swing and the thrown blade.",
      "stager": "player",
      "seconds": 6,
      "sources": [
        "src/presentation/entities/player-renderer.ts",
        "src/presentation/entities/blade-renderer.ts"
      ]
    },
    {
      "id": "weapons",
      "about": "Each weapon's blade alone: held, swung, thrown, stuck and recalled.",
      "stager": "weapon",
      "seconds": 6,
      "sources": [
        "src/presentation/entities/blade-renderer.ts"
      ]
    },
    {
      "id": "enemies",
      "about": "Every enemy and variant in each state its behaviour visits, then hurt and four steps of its death.",
      "stager": "enemy",
      "seconds": 14,
      "variantSeconds": 8,
      "sources": [
        "src/presentation/enemies/renderers/standard-renderers.ts"
      ]
    },
    {
      "id": "bosses",
      "about": "Every boss in each phase: each attack with its tell, active, recover and punish stages, hurt, and death.",
      "stager": "boss",
      "seconds": 40,
      "sources": [
        "src/presentation/enemies/renderers/boss-tell-renderer.ts",
        "src/presentation/enemies/renderers/boss-tell-skin.ts"
      ]
    },
    {
      "id": "stage-objects",
      "about": "Every stage object kind in each state, taken from the scene that first showed it.",
      "stager": null,
      "sources": []
    },
    {
      "id": "platforms",
      "about": "The platforms and floor of every stage, without the painted background.",
      "stager": "stage",
      "seconds": 1,
      "sources": [
        "src/presentation/backdrop.ts",
        "src/presentation/platform-materials/verdant-rootstone.ts",
        "src/presentation/platform-materials/pale-ice.ts",
        "src/presentation/scenes/scene-renderer.ts"
      ]
    },
    {
      "id": "projectiles",
      "about": "Every projectile family, one state per look, taken from the scene that first fired it.",
      "stager": null,
      "sources": [
        "src/presentation/entities/projectile-renderer.ts"
      ]
    }
  ],
