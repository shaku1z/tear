{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tear-preview",
  "compatibility_date": "2026-07-21",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist/standalone",
    "not_found_handling": "404-page"
  }
}
