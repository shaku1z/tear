rules_version = '2';
// Every collection the game uses is matched below; anything else is refused. Each rule is tested,
// allowed and refused writes both, under the Firestore emulator: tests/rules/firestore-rules.test.ts
// (`pnpm test:rules`). Change a rule and its tests in the same pull request. Deploying is the owner's step.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function incoming() {
      return request.resource.data;
    }
    // The keys this write changes, adds or removes (the whole document on a create).
    function changedKeys() {
      return resource == null ? incoming().keys() : incoming().diff(resource.data).affectedKeys();
    }
    function intIn(value, low, high) {
      return value is int && value >= low && value <= high;
    }
    function stringIn(value, low, high) {
      return value is string && value.size() >= low && value.size() <= high;
    }
    // A client clock reading (Date.now()) within ten minutes of the server's.
    function nearNow(ms) {
      return ms is int && ms > request.time.toMillis() - 600000 && ms < request.time.toMillis() + 600000;
    }

    // Each player owns their cloud save: exactly a profile blob and a meta blob. The display name lives
    // inside the profile and is validated in the game. A write may change only those two fields, so
    // documents from older builds that hold other fields still save.
    match /users/{uid} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
                            && changedKeys().hasOnly(['profile', 'meta'])
                            && incoming().profile is map
                            && incoming().meta is map;
    }

    // Public leaderboards. A player writes only their own row, and only two kinds of write:
    //  - a new best: every row field, a better value than the row holds, at least 10 s after the last;
    //  - the replay link: only replayId, naming a replay this player owns (so the value stays as it was).
    // Score boards, one per mode the LEADERBOARDS screen lists times DIFFICULTY_IDS, keep the highest
    // score. Gauntlet clear boards, one per difficulty, keep the fastest clear: score is the clear time in
    // simulation ticks (120 a second), wave the trials cleared. The rules test fails when the game's
    // lists change without these.
    function isBoard(board) {
      return board in [
        'campaign_easy', 'campaign_normal', 'campaign_hard', 'campaign_extreme', 'campaign_onehit',
        'endless_easy', 'endless_normal', 'endless_hard', 'endless_extreme', 'endless_onehit',
        'gauntlet_easy', 'gauntlet_normal', 'gauntlet_hard', 'gauntlet_extreme', 'gauntlet_onehit'
      ];
    }
    function isClearBoard(board) {
      return board in [
        'gauntletclear_easy', 'gauntletclear_normal', 'gauntletclear_hard', 'gauntletclear_extreme',
        'gauntletclear_onehit'
      ];
    }
    function isRow(row, uid) {
      return stringIn(row.name, 1, 16) && row.name.matches('[A-Za-z0-9 _-]+')
          && intIn(row.time, 0, 10000000)
          && row.uid == uid
          && nearNow(row.ts);
    }
    function isRowWrite() {
      return changedKeys().hasOnly(['name', 'score', 'wave', 'time', 'uid', 'ts'])
          && (resource != null || incoming().keys().hasAll(['name', 'score', 'wave', 'time', 'uid', 'ts']));
    }
    function afterLastWrite() {
      return incoming().ts >= resource.data.get('ts', 0) + 10000;
    }
    function isNewBest(uid) {
      return isRowWrite() && isRow(incoming(), uid)
          && intIn(incoming().score, 1, 1000000000)
          && intIn(incoming().wave, 0, 100000)
          && (resource == null || (incoming().score > resource.data.get('score', 0) && afterLastWrite()));
    }
    // A clear takes at least a minute (7,200 ticks) and at most four hours (1,728,000 ticks).
    function isNewFastest(uid) {
      return isRowWrite() && isRow(incoming(), uid)
          && intIn(incoming().score, 7200, 1728000)
          && intIn(incoming().wave, 1, 32)
          && (resource == null || (incoming().score < resource.data.get('score', 1728001) && afterLastWrite()));
    }
    function isReplayLink(uid) {
      return resource != null
          && changedKeys().hasOnly(['replayId'])
          && stringIn(incoming().replayId, 1, 128)
          && get(/databases/$(database)/documents/replays/$(incoming().replayId)).data.ownerUid == uid;
    }
    match /leaderboards/{board}/scores/{uid} {
      allow read: if true;
      allow create, update: if isUser(uid)
                            && ((isBoard(board) && isNewBest(uid))
                                || (isClearBoard(board) && isNewFastest(uid))
                                || ((isBoard(board) || isClearBoard(board)) && isReplayLink(uid)));
      allow delete: if isUser(uid);
    }

    // Append-only balancing statistics, anonymous by construction (no account id). The developer reads
    // them in the console. Only the events the game sends, a clock reading and a bounded number of fields.
    match /telemetry/{doc} {
      allow create: if signedIn()
                    && incoming().event in ['run_end']
                    && nearNow(incoming().ts)
                    && incoming().size() <= 32;
      allow read, update, delete: if false;
    }

    // One replay ghost per board: legacy, superseded by /replays. The game only reads it; nobody writes.
    match /ghosts/{board} {
      allow read: if true;
      allow write: if false;
    }

    // Published replays: a summary document, with the recording in up to 6 chunks of at most 500,000
    // characters underneath (publishReplay caps the recording at 3,000,000). Anyone can watch; only the
    // owner (the Replay Passport uid) writes. A leaderboard replay has the fixed id
    // lb_<board>_<difficulty>_<uid>, so only that player can hold it, and re-publishing replaces it with
    // set(); chunks from a longer earlier copy stay at or above the new chunkCount, unread and unwritable.
    // Any other replay id is r followed by base-36 characters.
    function isReplayId(id) {
      return id.matches('lb_[a-z]+_[a-z]+_' + request.auth.uid) || id.matches('r[0-9a-z]{1,32}');
    }
    // The fields publishReplay writes (src/platform/firebase-cloud.ts).
    function isReplaySummary() {
      return incoming().keys().hasOnly(['ownerUid', 'createdAt', 'chunkCount', 'mode', 'diff', 'wave', 'score',
                                        'time', 'won', 'kills', 'peak', 'name', 'thumb', 'lb'])
          && incoming().ownerUid == request.auth.uid
          && intIn(incoming().chunkCount, 1, 6)
          && stringIn(incoming().name, 1, 32)
          && nearNow(incoming().createdAt);
    }
    match /replays/{id} {
      allow read: if true;
      allow create: if signedIn() && isReplayId(id) && isReplaySummary();
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && isReplaySummary();
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      match /chunks/{n} {
        allow read: if true;
        // Only the parent replay's owner writes its chunks (the parent is written first).
        allow create, update: if signedIn()
                              && n.matches('[0-5]')
                              && get(/databases/$(database)/documents/replays/$(id)).data.ownerUid == request.auth.uid
                              && int(n) < get(/databases/$(database)/documents/replays/$(id)).data.chunkCount
                              && incoming().keys().hasOnly(['d'])
                              && stringIn(incoming().d, 0, 500000);
        allow delete: if false;
      }
    }
  }
}
