rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // each player owns their cloud save (the display name lives inside the profile blob
    // and is validated client-side, so this stays a plain owner-only rule — a validation
    // clause here referencing request.resource.data would break READS, which have none).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // public leaderboards; you may only write/delete your own entry, score must be numeric
    match /leaderboards/{board}/scores/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.score is number;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // append-only balancing telemetry (developer reads in the console only)
    match /telemetry/{doc} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    // one replay ghost per board — legacy, superseded by /replays; the game only reads it, nobody writes
    match /ghosts/{board} {
      allow read: if true;
      allow write: if false;
    }
    // published replays: a RunSummary doc + the recording chunked underneath.
    // Anyone can watch; only the owner (the Replay Passport uid) can create/replace/delete.
    match /replays/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      match /chunks/{n} {
        allow read: if true;
        // only the parent replay's owner may write its chunks (the parent is written first)
        allow create, update: if request.auth != null
                              && get(/databases/$(database)/documents/replays/$(id)).data.ownerUid == request.auth.uid;
        allow delete: if false;
      }
    }
  }
}
