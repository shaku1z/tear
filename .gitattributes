# Files excluded from the CrazyGames submission build.
# `git archive` honours `export-ignore`, so `npm run pack:cg` (see CRAZYGAMES.md)
# produces a zip containing only the playable game — none of the items below.
#
# experiments/coop-lab.html uses external WebRTC/STUN servers, which fails
# CrazyGames' "no external" checks, so it must NOT ship in the package.
experiments/coop-lab.html export-ignore
signaling/         export-ignore
scripts/serve.py   export-ignore
DEPLOYMENT.md      export-ignore
CRAZYGAMES.md      export-ignore
.gitignore         export-ignore
.gitattributes     export-ignore
.claude/           export-ignore
js/DESIGN_SYSTEM.md export-ignore

# TearScore provenance hashes must survive platform-specific checkouts exactly.
public/vendor/tear-score/*.js text eol=lf
public/vendor/tear-score/*.json text eol=lf
public/vendor/tear-score/*.md text eol=lf
# Canonical Adaptive Soundtrack vendor hashes must survive platform checkouts exactly.
public/vendor/tear-music/*.js text eol=lf
public/vendor/tear-music/*.json text eol=lf
public/vendor/tear-music/*.md text eol=lf
docs/tearbench-ghost3-requirements.json text eol=lf
docs/TEARBENCH_GHOST3_NON_LOSSY_REQUIREMENTS_ANNEX.md text eol=lf
docs/TEARBENCH_GHOST3_CAPABILITY_DASHBOARD.md text eol=lf
