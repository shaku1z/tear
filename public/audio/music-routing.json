    },
    {
      "id": "voidspire-gameplay",
      "match": { "biome": "the-voidspire", "scene": "gameplay" },
      "selection": { "type": "primary", "workId": "looking-out" }
    },
    {
      "id": "tear-gameplay",
      "match": { "biome": "the-tear", "scene": "gameplay" },
