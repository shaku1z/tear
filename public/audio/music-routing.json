    },
    {
      "id": "undercroft-gameplay",
      "match": { "biome": "the-undercroft", "scene": "gameplay" },
      "selection": { "type": "primary", "workId": "slicing-life-2" }
    },
    {
      "id": "crimson-gameplay",
      "match": { "biome": "the-crimson-fields", "scene": "gameplay" },
